# 1. Get a free key at https://console.groq.com/keys
# 2. Copy this file to .env and paste the key below. One key powers both Whisper and the AI.
GROQ_API_KEY=

# Your name, used in prompts so posts sound like you
CREATOR_NAME=Rehan

# Optional overrides (any OpenAI-compatible API works)
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# WHISPER_MODEL=whisper-large-v3-turbo
# LLM_BASE_URL=https://api.groq.com/openai/v1
# DATABASE_URL=postgresql://...   (Neon; leave empty to use a local SQLite file)
# ENCORE_MOCK=1                    (demo mode: runs with no key, clearly labelled)
